; Engine configuration file.
config_version=5

[application]

config/name="Peglord"
config/description="Drop balls through a pub bagatelle board to bank XP, then fight the Landlord's goons."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.05, 0.04, 1)
boot_splash/show_image=false

[autoload]

D="*res://scripts/data.gd"
Bus="*res://scripts/bus.gd"
S="*res://scripts/state.gd"
Sfx="*res://scripts/sfx.gd"
Battle="*res://scripts/battle.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1
